rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Products collection: Anyone can read active products, store managers can write
    match /products/{productId} {
      allow read: if true;
      allow write: if true; // Allows demo app catalog management & auto stock updates
    }

    // Orders collection: Customer can create order, anyone with order ID can track it
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Settings collection: Store profile, payment QR & account info, LINE notify settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Chat messages collection: Inquiries between customers and store owner
    match /chats/{chatId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Customer Loyalty Points collection: Rewards, tiers, and point balances
    match /points/{phone} {
      allow read: if true;
      allow write: if true;
    }
  }
}
